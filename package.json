{
  "name": "frankai-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4300",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone-assets.mjs",
    "start": "next start -H 127.0.0.1 -p 4300",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts tests/**/*.test.ts",
    "test:browser": "playwright test",
    "deploy:production": "bash scripts/deploy-production.sh",
    "readiness": "node scripts/readiness-check.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "security:benchmark": "node scripts/benchmark-password.mjs",
    "auth:migrate-file": "node scripts/migrate-file-auth.mjs",
    "memory:rebuild-index": "node scripts/rebuild-memory-index.mjs",
    "build:services": "tsc -p tsconfig.services.json",
    "test:vertical-slice": "node --import tsx --test tests/vertical-slice/**/*.test.ts",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:orchestrator": "tsx services/orchestrator/src/server.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "fastify": "^5.12.3",
    "next": "^16.3.5",
    "nodemailer": "^9.1.1",
    "openai": "^7.4.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
