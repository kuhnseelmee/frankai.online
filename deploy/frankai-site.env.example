# Copy to /etc/frankai-site.env and set real secrets there.
# Keep this file free of production values.

HOSTINGER_MAIL_WEBHOOK_SECRET=
HOSTINGER_MAIL_WEBHOOK_MAX_BYTES=131072

MEMORY_INGEST_SECRET=
MEMORY_INGEST_DIR=/var/lib/frankai-site/memory-ingest
MEMORY_INGEST_MAX_BYTES=131072
MEMORY_INDEX_DIR=/var/lib/frankai-site/memory-index
MEMORY_SEARCH_MAX_BYTES=16384

# Authentication: generate both with `openssl rand -hex 32`; never commit real values.
AUTH_DATA_DIR=/var/lib/frankai-site/auth
AUTH_STORE=postgres
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=https://frankai.online
JWT_AUDIENCE=frankai-web
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
PUBLIC_SIGNUP_ENABLED=false
INVITATION_SIGNUP_ENABLED=true
DATABASE_URL=
DATABASE_SSL=false
AUTH_DATABASE_ENABLED=true
MFA_ENCRYPTION_KEY=
TRUST_PROXY=true
ADMIN_MFA_REQUIRED=true
ADMIN_REAUTH_MAX_AGE_SECONDS=600
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

EMAIL_ENABLED=false
EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

RATE_LIMIT_STORE=postgres
RATE_LIMIT_PREFIX=frankai

# Voice remains fail-closed until a realtime transport is configured and audited.
VOICE_SESSION_MAX_MINUTES=20
VOICE_IDLE_TIMEOUT_SECONDS=120
VOICE_MAX_CONCURRENT_PER_USER=1
VOICE_DAILY_MINUTE_LIMIT=30
VOICE_ENABLED=false
TRANSCRIPT_RETENTION_ENABLED=false
AUDIO_RETENTION_ENABLED=false

FRANKAI_PLATFORM_CONFIG_FILE=/var/lib/frankai-site/platform/config.json
FRANKAI_PLATFORM_ADMIN_MAX_BYTES=262144

CONTACT_ENQUIRY_DIR=/var/lib/frankai-site/contact
CONTACT_IP_HASH_SALT=

# Keep false unless you explicitly want accepted mail webhook metadata queued.
# Raw email bodies are not stored by the default webhook integration.
MEMORY_INGEST_FROM_HOSTINGER_MAIL=false
