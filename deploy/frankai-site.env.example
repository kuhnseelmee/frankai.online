# Copy to /etc/frankai-site.env and set real secrets there.
# Keep this file free of production values.

HOSTINGER_MAIL_WEBHOOK_SECRET=
HOSTINGER_MAIL_WEBHOOK_MAX_BYTES=131072

MEMORY_INGEST_SECRET=
MEMORY_INGEST_DIR=/var/lib/frankai-site/memory-ingest
MEMORY_INGEST_MAX_BYTES=131072
MEMORY_INDEX_DIR=/var/lib/frankai-site/memory-index
MEMORY_SEARCH_MAX_BYTES=16384

FRANKAI_PLATFORM_ADMIN_TOKEN=
FRANKAI_PLATFORM_CONFIG_FILE=/var/lib/frankai-site/platform/config.json
FRANKAI_PLATFORM_ADMIN_MAX_BYTES=262144

# Keep false unless you explicitly want accepted mail webhook metadata queued.
# Raw email bodies are not stored by the default webhook integration.
MEMORY_INGEST_FROM_HOSTINGER_MAIL=false
