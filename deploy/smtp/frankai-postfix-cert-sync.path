[Unit]
Description=Watch Caddy mail certificate for Postfix refresh

[Path]
PathChanged=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.frankai.online/mail.frankai.online.crt
PathChanged=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.frankai.online/mail.frankai.online.key
Unit=frankai-postfix-cert-sync.service

[Install]
WantedBy=multi-user.target
