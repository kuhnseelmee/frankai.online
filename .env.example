NODE_ENV=production
APP_BASE_URL=https://frankai.online
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=https://frankai.online
JWT_AUDIENCE=frankai-web
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
PUBLIC_SIGNUP_ENABLED=false
INVITATION_SIGNUP_ENABLED=true
AUTH_STORE=postgres
AUTH_DATABASE_ENABLED=true
ADMIN_MFA_REQUIRED=true
ADMIN_REAUTH_MAX_AGE_SECONDS=600
EMAIL_ENABLED=false
EMAIL_PROVIDER=log
RATE_LIMIT_STORE=postgres
DATABASE_URL=
DATABASE_SSL=false
AUTH_DATABASE_ENABLED=false
MFA_ENCRYPTION_KEY=
OPENAI_API_KEY=
FRANKAI_API_PORT=8081
FRANKAI_API_BIND_HOST=127.0.0.1
API_ORCHESTRATOR_URL=http://orchestrator:8080
API_BEARER_TOKEN_FILE=/run/secrets/api_bearer_token
ORCHESTRATOR_BIND_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_MODEL=gpt-5.6-luna
ORCHESTRATOR_OPENAI_KEY_FILE=/run/secrets/openai_api_key
ORCHESTRATOR_MODEL_MODE=openai
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_DEFAULT_VOICE=
VOICE_ENABLED=false
VOICE_SESSION_MAX_MINUTES=20
VOICE_IDLE_TIMEOUT_SECONDS=120
VOICE_MAX_CONCURRENT_PER_USER=1
VOICE_DAILY_MINUTE_LIMIT=30
TRANSCRIPT_RETENTION_ENABLED=false
AUDIO_RETENTION_ENABLED=false
